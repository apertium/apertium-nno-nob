<dictionary>
<!--
Spørsmål til trond.trosterud ved uit.no
eller unhammer+apertium ved mm.st

***** r="LR/RL" vs lrx-reglar: *****

Av og til kan me løysa eit ordval anten med r="LR/RL" eller med
lrx-reglar. Viss begge ordval er moglege innanfor norma til ein og
same brukar (avhengig av kontekst/tyding), så bruker me lrx. Reine
formval/normeringar legg me anten inn som preferansar (viss det er
sannsynleg at nokon vil velja den andre forma), eller så bruker me
r="LR/RL".

Helst løyser me slikt i den einspråklege ordboka, og gir dei same
lemma – sjå stave-pardefs av typen "lykk" i nno.dix. Dette gjer det
enklare å laga meir generelle preferanse-variantar.

TODO: nob.dix burde ha stave-pardefs òg, for t.d.:
eigen => egen, leite => lete, band => bånd, fram => frem, hemming => hemning, overskott => overskudd

***** Innhald: *****
| Pronomen          | "prn"    |
| Determinatorar    | "det"    |
| Tal               | "det qnt"| (var "num")
| Konjunksjonar     |          |
| - underordna      | "cnjsub" |
| - sideordna       | "cnjcoo" |
| Preposisjonar     | "pr"     |
| Substantiv        |          |
| - Fellesnamn      | "n"      |
| - Eigenamn        | "np"     |
| Adjektiv          | "adj"    |
| Verb              | "vblex"  |
| Adverb            | "adv"    |
| Regulære uttrykk  |          |
-->
  <alphabet/>
  <sdefs>
    <sdef n="n"       c="Noun"/>
    <sdef n="np"      c="Proper noun"/>
    <sdef n="prn"     c="Pronoun"/>
    <sdef n="det"     c="Determiner"/>
    <sdef n="pos"     c="Possessive"/>

    <sdef n="p1"      c="1st person"/>
    <sdef n="p2"      c="2nd person"/>
    <sdef n="p3"      c="3rd person"/>

    <sdef n="nt"      c="Neuter"/>
    <sdef n="mf"      c="Masculine / feminine, also utrum in nouns"/>
    <sdef n="un"      c="No gender"/>
    <sdef n="f"       c="Feminine"/>
    <sdef n="m"       c="Masculine"/>

    <sdef n="sp"      c="Singular / plural"/>
    <sdef n="sg"      c="Singular"/>
    <sdef n="pl"      c="Plural"/>

    <sdef n="ind"     c="Indefinite"/>
    <sdef n="def"     c="Definite"/>

    <sdef n="nom"     c="Nominative"/>
    <sdef n="acc"     c="Accusative"/>        <!-- objective case -->
    <sdef n="gen"     c="Genitive"/>

    <sdef n="dem"     c="Demonstrative"/>
    <sdef n="itg"     c="Question word / interrogative"/>
    <sdef n="qnt"     c="Quantifier"/>
    <sdef n="neg"     c="Negative"/>
    <sdef n="emph"    c="Emphatic"/>
    <sdef n="pers"    c="Personal (pronoun)"/>

    <sdef n="vblex"   c="Verb"/>
    <sdef n="pstv"    c="-st verb (Nynorsk)"/>
    <sdef n="pasv"    c="Passive (Bokmål) or -st form (Nynorsk)"/>
    <sdef n="inf"     c="Infinitive"/>
    <sdef n="pres"    c="Present"/>
    <sdef n="imp"     c="Imperative"/>
    <sdef n="pret"    c="Preterite"/>
    <sdef n="pp"      c="Perfect participle"/>
    <sdef n="pprs"  c="Present participle (adjectival)"/>

    <sdef n="pr"      c="Preposition"/>
    <sdef n="ij"      c="Interjection"/>
    <sdef n="adv"     c="Adverb"/>
    <sdef n="adj"     c="Adjective"/>
    <sdef n="sint"    c="Synthetic (of adjectives)"/>
    <sdef n="part"    c="Participle (infinitive)"/>
    <sdef n="cnjsub"  c="Subordinating conjunction"/>
    <sdef n="cnjcoo"  c="Co-ordinating conjunction"/>
    <sdef n="cnjadv"  c="Adverbial conjunction"/>

    <sdef n="pst"     c="Positive"/>
    <sdef n="comp"    c="Comparative"/>
    <sdef n="sup"     c="Superlative"/>
    <sdef n="xpst"    c="Positive derivative"/>
    <sdef n="xpsts"   c="Positive derivative of synthetics"/>
    <sdef n="xpsto"   c="Positive derivative of ordinals"/>
    <sdef n="xcomp"   c="Comparative derivative"/>
    <sdef n="xsup"    c="Superlative derivative"/>

    <sdef n="ord"     c="Ordinal"/>
    <sdef n="acr"     c="Acronym"/>
    <sdef n="sent"    c="Sentence end" />
    <sdef n="cm"      c="Comma" />
    <sdef n="guio"      c="Dash" />
    <sdef n="clb"     c="Possible clause boundary"/>
    <sdef n="overskrift" c="Headline"/>
    <sdef n="apos"    c="Apostrophe" />
    <sdef n="lpar"    c="Left parenthesis" />
    <sdef n="rpar"    c="Right parenthesis" />
    <sdef n="lquot"   c="Left quotation mark"/>
    <sdef n="rquot"   c="Right quotation mark"/>

    <sdef n="top"     c="Toponym" />
    <sdef n="cog"     c="Cognomen" />
    <sdef n="org"     c="Organisation" />
    <sdef n="ant"     c="Anthroponym" />
    <sdef n="attr"    c="Attributive (certain proper nouns)" />
    <sdef n="init"    c="Initials"/>
    <sdef n="al"      c="Altres / misc proper nouns"/>

    <sdef n="cmp"     c="Compound-left-part"/>
    <sdef n="cmp-split" c="Split compound-left-part"/>

    <sdef n="guess" 	c="Guesser"/>
    <sdef n="cgguess" 	c="CG Guesser"/>
    <sdef n="url" 	c="URL/E-mail"/>

    <sdef n="GD"     c="Género por determinar" />
    <sdef n="ND"     c="Número por determinar" />

    <sdef n="remspc" c="Tell transfer to remove preceding space"/>
  </sdefs>

  <pardefs>
    <!--
        A colon (:) in pardef names separate the left from the right,
        while _ often separates consecutive tags; so a pardef name
        like foo_bar:fie_fum probably translates left-side tags foo
        and bar into right-side tags fie and fum.
    -->

    <pardef n="sgpl:sp" c="for eg. bokmål sp to a full paradigm in nynorsk">
<e r="LR"><p><l><s n="pl"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
<e r="LR"><p><l><s n="pl"/><s n="def"/></l><r><s n="sp"/></r></p></e>
<e>       <p><l><s n="sg"/><s n="ind"/></l><r><s n="sp"/></r></p></e>
<e r="LR"><p><l><s n="sg"/><s n="def"/></l><r><s n="sp"/></r></p></e>
    </pardef>
    <pardef n="sp:sgpl" c="for eg. nynorsk sp to a full paradigm in bokmål">
<e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="def"/></r></p></e>
<e>       <p><l><s n="sp"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="sp"/></l><r><s n="sg"/><s n="def"/></r></p></e>
    </pardef>
    <pardef n="@sgpl" c="restrict to sg/pl">
<e>         <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
<e>         <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>
    <pardef n="@sg" c="restrict to sg">
<e>         <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
    </pardef>
    <pardef n="@pl" c="restrict to pl">
<e>         <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>

    <pardef n="sp:pl" c="for eg. nynorsk sp to a pl-parts of bokmål">
<e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="sp"/></l><r><s n="pl"/><s n="def"/></r></p></e>
<e>       <p><l><s n="sp"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
<e r="RL"><p><l><s n="sp"/></l><r><s n="sg"/><s n="def"/></r></p></e>
    </pardef>
    <pardef n="nbr_art" c="fill up paradigm, to ensure we keep include ambiguous entries">
<e>         <p><l><s n="pl"/><s n="ind"/></l><r><s n="pl"/><s n="ind"/></r></p></e>
<e>         <p><l><s n="pl"/><s n="def"/></l><r><s n="pl"/><s n="def"/></r></p></e>
<e>         <p><l><s n="sg"/><s n="ind"/></l><r><s n="sg"/><s n="ind"/></r></p></e>
<e>         <p><l><s n="sg"/><s n="def"/></l><r><s n="sg"/><s n="def"/></r></p></e>
    </pardef>

    <pardef n="n_m|f:n_m" c="Ambiguous! Let biprefs handle it">
<e>         <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="f"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>

    <pardef n="n_m_allow_f">
<e r="LR">  <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>
    <pardef n="n_f_LR_m:n_m_RL_f">
<e r="LR">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>
    <pardef n="n_nt_allow_m">
<e r="LR">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="nt"/></r></p></e>
<e>         <p><l><s n="n"/><s n="nt"/></l> <r><s n="n"/><s n="nt"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="nt"/></l> <r><s n="n"/><s n="m"/></r></p></e>
    </pardef>
    <pardef n="skap_n_nt|m" c="Words for which m/f gender can be overridden in preferences.
                               (E.g. NPK prefers nt for certain ~skap nouns, Cappelen always m.)
                               Words using this paradigm need rules in biprefs.rlx!">
<e>         <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="nt"/></r></p></e>
<e>         <p><l><s n="n"/><s n="nt"/></l> <r><s n="n"/><s n="nt"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="nt"/></l> <r><s n="n"/><s n="m"/></r></p></e>
    </pardef>
    <pardef n="n_m_allow_nt">
<e r="LR">  <p><l><s n="n"/><s n="nt"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="nt"/></r></p></e>
    </pardef>
    <pardef n="n_m_LR_f:">
<e>         <p><l><s n="n"/><s n="m"/></l> <r></r></p></e>
<e r="LR">  <p><l><s n="n"/><s n="f"/></l> <r></r></p></e>
    </pardef>
    <pardef n="n_f_LR_m:">
<e r="LR">  <p><l><s n="n"/><s n="m"/></l> <r></r></p></e>
<e>         <p><l><s n="n"/><s n="f"/></l> <r></r></p></e>
    </pardef>
    <pardef n="n_f_LR_nt:">
<e r="LR">  <p><l><s n="n"/><s n="nt"/></l> <r></r></p></e>
<e>         <p><l><s n="n"/><s n="f"/></l> <r></r></p></e>
    </pardef>
    <pardef n="lov_n_f|m:" c="Words for which m/f gender can be overridden in preferences.
                              (E.g. NPK prefers apa/banen, Cappelen apen/bana.)
                              Words using this paradigm need to be covered by rules in biprefs.rlx!">
<e>         <p><l><s n="n"/><s n="m"/></l> <r></r></p></e>
<e>         <p><l><s n="n"/><s n="f"/></l> <r></r></p></e>
    </pardef>
    <pardef n=":n_m_RL_f">
<e>         <p><l></l>                     <r><s n="n"/><s n="m"/></r></p></e>
<e r="RL">  <p><l></l>                     <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>
    <pardef n=":n_m_RL_nt">
<e r="RL">  <p><l></l>                     <r><s n="n"/><s n="nt"/></r></p></e>
<e>         <p><l></l>                     <r><s n="n"/><s n="m"/></r></p></e>
    </pardef>
    <pardef n=":n_nt_RL_m">
<e r="RL">  <p><l></l>                     <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l></l>                     <r><s n="n"/><s n="nt"/></r></p></e>
    </pardef>
    <pardef n=":n_f_RL_m">
<e r="RL">  <p><l></l>                     <r><s n="n"/><s n="m"/></r></p></e>
<e>         <p><l></l>                     <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>
    <pardef n="n_m_LR_nt:">
<e r="LR">  <p><l><s n="n"/><s n="nt"/></l> <r></r></p></e>
<e>         <p><l><s n="n"/><s n="m"/></l> <r></r></p></e>
    </pardef>
    <pardef n="n_nt_LR_m:">
<e r="LR">  <p><l><s n="n"/><s n="m"/></l> <r></r></p></e>
<e>         <p><l><s n="n"/><s n="nt"/></l> <r></r></p></e>
    </pardef>
    <pardef n="n_m_nt">
      <!-- a lot of nouns have this (eg. languages): -->
<e>       <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>       <p><l><s n="n"/><s n="nt"/></l><r><s n="n"/><s n="nt"/></r></p></e>
    </pardef>
    <pardef n="n_m_f">
<e>       <p><l><s n="n"/><s n="m"/></l> <r><s n="n"/><s n="m"/></r></p></e>
<e>       <p><l><s n="n"/><s n="f"/></l> <r><s n="n"/><s n="f"/></r></p></e>
    </pardef>
    <pardef n="LR_f:m">
      <!-- for eg. determiners, pronouns, ...non-nouns -->
<e r="LR"><p><l><s n="f"/></l><r><s n="m"/></r></p></e>
<e>       <p><l></l>          <r></r></p></e>
<!-- Without the RL entry below, the right-to-left compilation will
     give an error (hint: the left side of an entry is empty), due to
     the above empty transduction -->
<e r="RL">  <p><l><s n="f"/></l><r><s n="f"/></r></p></e>
    </pardef>
    <pardef n="LR_f:m_mf">
      <!-- for eg. determiners, pronouns, ...non-nouns -->
<e r="LR"><p><l><s n="f"/></l><r><s n="m"/></r></p></e>
<e r="RL"><p><l><s n="m"/></l><r><s n="mf"/></r></p></e>
<e>       <p><l></l>          <r></r></p></e>
<!-- Without the RL entry below, the right-to-left compilation will
     give an error (hint: the left side of an entry is empty), due to
     the above empty transduction -->
<e r="RL">  <p><l><s n="f"/></l><r><s n="f"/></r></p></e>
    </pardef>
    <pardef n="f_m:mf" c="includes empty transition">
<e>         <p><l><s n="f"/></l><r><s n="mf"/></r></p></e>
<e>         <p><l><s n="m"/></l><r><s n="mf"/></r></p></e>
<e>         <p><l></l>          <r></r></p></e>
    </pardef>

    <pardef n="GD:m_f__pl:pl" c="fully specified so we can add ambiguous entries for some of them
                                 e.g. kva for nokre is ambig only with un.pl">
<e r="LR"><p><l><s n="f"/></l>             <r><s n="m"/></r></p></e>
<e>       <p><l></l>                       <r></r></p></e>
<e>       <p><l><s n="un"/><s n="pl"/></l> <r><s n="un"/><s n="pl"/></r></p></e>
<e r="RL"><p><l><s n="GD"/><s n="sg"/></l> <r><s n="m"/><s n="sg"/></r></p></e>
<e r="RL"><p><l><s n="GD"/><s n="sg"/></l> <r><s n="f"/><s n="sg"/></r></p></e>
<e r="RL"><p><l><s n="nt"/><s n="sg"/></l> <r><s n="nt"/><s n="sg"/></r></p></e>
    </pardef>

    <pardef n="n_cmp_only">
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>
<e><p><l><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp-split"/></r></p></e>
    </pardef>


  <pardef n="pos-RL_f">
<e>       <p><l><s n="un"/></l><r><s n="un"/></r></p></e>
<e>       <p><l><s n="nt"/></l><r><s n="nt"/></r></p></e>
<e>       <p><l><s n="m"/></l><r><s n="m"/></r></p></e>
<e r="LR"><p><l><s n="f"/></l><r><s n="m"/></r></p></e>
<e r="RL"><p><l><s n="f"/></l><r><s n="f"/></r></p></e>
    </pardef>
    <pardef n="det+prn_pos">
<e>         <p><l><s n="prn"/><s n="pos"/></l>  <r><s n="prn"/><s n="pos"/></r></p></e>
<e>         <p><l><s n="det"/><s n="pos"/></l>  <r><s n="det"/><s n="pos"/></r></p></e>
  </pardef>
    <pardef n="det+prn_pos-RL_f">
<e>         <p><l><s n="prn"/><s n="pos"/></l>  <r><s n="prn"/><s n="pos"/></r></p><par n="pos-RL_f"/></e>
<e>         <p><l><s n="det"/><s n="pos"/></l>  <r><s n="det"/><s n="pos"/></r></p><par n="pos-RL_f"/></e>
  </pardef>
    <pardef n="pass:pstv" c="non-listed forms simply trimmed">
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l><r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
    </pardef>
    <pardef n="actv:pstv" c="Translate pstv to regular active">
<e>       <p><l><s n="vblex"/><s n="inf"/></l>              <r><s n="vblex"/><s n="pstv"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/></l>             <r><s n="vblex"/><s n="pstv"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l><r><s n="vblex"/><s n="pstv"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pret"/></l><r><s n="vblex"/><s n="pstv"/><s n="pret"/></r></p></e>
    </pardef>
    <pardef n="actv:pasv" c="Translate nob passive to nno active, exclude other forms">
<e>       <p><l><s n="vblex"/><s n="pres"/></l>             <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/></l>             <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
    </pardef>
    <pardef n="pstv:pass" c="Note: unless the translation using this paradigm is LR,
                             you also need to specify additional RL adj.pp/adj.pprs entries
                             See eg. ringast/minke-forringe">
<e r="RL"><p><l><s n="vblex"/><s n="pstv"/><s n="inf"/></l><r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="inf"/></l><r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e r="RL"><p><l><s n="vblex"/><s n="pstv"/><s n="pres"/></l><r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pres"/></l><r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<!-- these next are not ideal... could put a reflexive in there with a
     transfer rule or something, not sure what would work most
     generally though: -->
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pp"/></l><r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pstv"/><s n="pret"/></l><r><s n="vblex"/><s n="pret"/></r></p></e>
<e r="RL"><p><l><s n="vblex"/><s n="pstv"/><s n="inf"/></l><r><s n="vblex"/><s n="imp"/></r></p></e>
    </pardef>
    <pardef n="vblex_adj" c="Specify full tag sequence, so we retain ambiguity if an alternate
                             lexical selection uses pstv:pass-pardef.">
<e>       <p><l><s n="vblex"/><s n="inf"/></l>               <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>  <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/></l>              <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pret"/></l>              <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="imp"/></l>               <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="vblex"/></l>                           <r><s n="vblex"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pp"/></l>                  <r><s n="adj"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="adj"/><s n="pprs"/></l>                <r><s n="adj"/><s n="pprs"/></r></p></e>
<!-- dei er tekne → de er tatt: -->
<e r="LR"><p><l><s n="adj"/><s n="pp"/><s n="pl"/></l><r><s n="adj"/><s n="pp"/><s n="mf"/><s n="sg"/><s n="ind"/></r></p></e>
    </pardef>
    <pardef n="vblex_noadj" c="For translating to/from g mwe's where adj's go badly">
<e>       <p><l><s n="vblex"/><s n="inf"/></l>               <r><s n="vblex"/><s n="inf"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="inf"/><s n="pasv"/></l>  <r><s n="vblex"/><s n="inf"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/></l>              <r><s n="vblex"/><s n="pres"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pres"/><s n="pasv"/></l> <r><s n="vblex"/><s n="pres"/><s n="pasv"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pp"/></l>                <r><s n="vblex"/><s n="pp"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="pret"/></l>              <r><s n="vblex"/><s n="pret"/></r></p></e>
<e>       <p><l><s n="vblex"/><s n="imp"/></l>               <r><s n="vblex"/><s n="imp"/></r></p></e>
<e>       <p><l><s n="vblex"/></l>                           <r><s n="vblex"/></r></p></e>
    </pardef>

    <pardef n="phrase__vblex">
<e>       <p><l><s n="vblex"/></l>               <r><s n="vblex"/></r></p></e>
    </pardef>

    <pardef n="adjgrad" c="Used by adj pardefs">
      <!-- slik at me kan ha
           foo<adj><pp> <=> bar<adj><pp>
           medan
           foo<adj><posi> <=> bum<adj><posi> -->
<e>       <p><l><s n="comp"/></l>  <r><s n="comp"/></r></p></e>
<e>       <p><l><s n="pst"/></l>   <r><s n="pst"/></r></p></e>
<e>       <p><l><s n="sup"/></l>   <r><s n="sup"/></r></p></e>
    </pardef>
    <pardef n="n.adjgrad" c="Used by adj pardefs for including genitive nominalisations of adj's">
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpst"/></l>  <r><s n="n"/><s n="xpst"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsts"/></l> <r><s n="n"/><s n="xpsts"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsto"/></l> <r><s n="n"/><s n="xpsto"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>
    <pardef n="adj" c="Non-verbal forms of adj">
<e>       <p><l><s n="adj"/></l>              <r><s n="adj"/></r></p><par n="adjgrad"/></e>
<e>       <par n="n.adjgrad"/></e>
    </pardef>

    <pardef n="adj_sint" c="synthetic on both sides">
<e>       <p><l><s n="adj"/><s n="sint"/></l> <r><s n="adj"/><s n="sint"/></r></p><par n="adjgrad"/></e>
<e>       <par n="n.adjgrad"/></e>
    </pardef>
    <pardef n="adj_sint:adj" c="synthetic on nno side; xpsts:xpst and let transfer deal with xcomp/xsup">
<e>       <p><l><s n="adj"/><s n="sint"/></l> <r><s n="adj"/></r></p><par n="adjgrad"/></e>
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsts"/></l> <r><s n="n"/><s n="xpst"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>
    <pardef n="adj:adj_sint" c="synthetic on nob side; xpst:xpsts and let transfer deal with xcomp/xsup">
<e>       <p><l><s n="adj"/></l>              <r><s n="adj"/><s n="sint"/></r></p><par n="adjgrad"/></e>
<e>       <p><l><s n="n"/><s n="xcomp"/></l> <r><s n="n"/><s n="xcomp"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpst"/></l>  <r><s n="n"/><s n="xpsts"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xsup"/></l>  <r><s n="n"/><s n="xsup"/></r></p></e>
    </pardef>

    <pardef n="adj_ord">
<e>       <p><l><s n="adj"/><s n="ord"/></l>              <r><s n="adj"/><s n="ord"/></r></p></e>
<e>       <p><l><s n="n"/><s n="xpsto"/></l> <r><s n="n"/><s n="xpsto"/></r></p></e>
    </pardef>

    <pardef n="n_acr" c="optional dot">
<e>       <re>.?</re><p><l><s n="n"/><s n="acr"/></l><r><s n="n"/><s n="acr"/></r></p></e>
    </pardef>

<pardef n="detqnt_ncmp">
  <e>       <p><l><s n="det"/><s n="qnt"/></l>          <r><s n="det"/><s n="qnt"/></r></p></e>
  <e>       <par n="n_cmp_only"/></e>
</pardef>

